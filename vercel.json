{
  "rewrites": [
    {
      "source": "/kritr/(.*)",
      "destination": "/kritr/"
    },
    {
      "source": "/terminal/(.*)",
      "destination": "/terminal/"
    },
    {
      "source": "/controllin/(.*)",
      "destination": "/controllin/"
    },
    {
      "source": "/aselget/(.*)",
      "destination": "/aselget/"
    },
    {
      "source": "/clashdle/assets/(.*)",
      "destination": "/clashdle/dist/assets/$1"
    },
    {
      "source": "/clashdle/(.*)",
      "destination": "/clashdle/dist/$1"
    }
  ]
}
